    "obsidian:init": "tsx src/cli.ts init-obsidian",
    "ingest:serenity": "tsx src/cli.ts ingest-serenity",
    "screen": "tsx src/cli.ts screen",
    "feishu:server": "tsx src/cli.ts feishu-server"
  },
  "keywords": [
    "a-share",

    "@earendil-works/pi-ai": "0.78.0",
    "dotenv": "17.2.3",
    "typebox": "1.1.38",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }

# Optional model configuration for live Pi Agent conversations.
TRADING_AGENT_MODEL_PROVIDER=deepseek
TRADING_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=

# Obsidian vault. Defaults to /Users/apple/Documents/HenryXu when unset.
OBSIDIAN_VAULT_PATH=/Users/apple/Documents/HenryXu
OBSIDIAN_KB_FOLDER=Serenity-A股产业投研

# A-share screener.
A_SHARE_MAX_ROWS=800
A_SHARE_TOP_N=15

# Feishu.
FEISHU_WEBHOOK_URL=
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_BOT_NAME=
FEISHU_APP_SECRET=
FEISHU_REPORT_APP_ID=
FEISHU_REPORT_APP_SECRET=
FEISHU_NOTIFY_OPEN_ID=
FEISHU_NOTIFY_CHAT_ID=
FEISHU_COMMAND_SENDER_OPEN_ID=
FEISHU_REPORT_NOTIFY_RECEIVE_ID_TYPE=
FEISHU_REPORT_NOTIFY_RECEIVE_ID=
FEISHU_REPORT_NOTIFY_OPEN_ID=
FEISHU_PORT=8787
FEISHU_DRY_RUN_REPLIES=false
FEISHU_REPLY_RENDER_MODE=text
FEISHU_WHITEBOARD_TOKEN=
FEISHU_WHITEBOARD_AS=user
FEISHU_WHITEBOARD_OVERWRITE=false
FEISHU_LOCAL_CALLBACK_URL=http://127.0.0.1:8787
LARK_CLI_PROFILE=
LARK_CLI_BIN=
FEISHU_PRIVATE_CHAT_ID=
FEISHU_POLLER_INTERVAL_MS=8000
FEISHU_POLLER_INITIAL_LOOKBACK_MINUTES=15
FEISHU_POLLER_MAX_BACKLOG_MINUTES=15
FEISHU_POLLER_STATE_PATH=runs/feishu-poller-state.json

# Local chatbot HTTP server.
CHAT_SERVER_PORT=8788

# FFD MCP connector. Defaults to ~/.ffd/run_ffd_mcp.sh when unset.
# Keep the FFD API Key in ~/.ffd/mcp-config.json, not in this repo.
FFD_MCP_COMMAND=

# Local licensed report/source inbox. Put PDF/MD/TXT files or manifest JSON here.
REPORT_INBOX=reports/inbox

# FFD report-library downloader output and processed Markdown artifacts.
FFD_REPORT_RAW_DIR=/Users/apple/Desktop/FFD研报库/_raw
FFD_REPORT_PROCESSED_DIR=reports/ffd/processed
# Optional high-quality document parser command. Supported placeholders:
# {input} = raw PDF/DOCX path, {outputDir} = temp output directory.
# Recommended MinerU API mode. Keep the token in local .env only.
MINERU_API_TOKEN=
MINERU_API_MODEL_VERSION=vlm
MINERU_API_LANGUAGE=ch
MINERU_API_ENABLE_TABLE=true
MINERU_API_ENABLE_FORMULA=true
MINERU_API_IS_OCR=true
FFD_REPORT_ENHANCE_TIMEOUT_MS=1200000
FFD_REPORT_ENHANCE_COMMAND=node scripts/mineru-api-convert.mjs {input} {outputDir}
# Local fallback if API quota/network is unavailable:
# FFD_REPORT_ENHANCE_COMMAND=MINERU_MODEL_SOURCE=modelscope /Users/apple/.local/share/mineru-venv/bin/mineru -p {input} -o {outputDir} -b pipeline -m auto -l ch
FFD_REPORT_RELAY_TOKEN=
FFD_FEISHU_WEBHOOK_URL=

# Embedding provider for local report-library retrieval (priority: siliconflow -> ollama -> lexical-only)
SILICONFLOW_API_KEY=<your siliconflow api key>
# LIBRARY_EMBEDDING_PROVIDER=siliconflow | ollama   (optional override)
# LIBRARY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B   (optional override)

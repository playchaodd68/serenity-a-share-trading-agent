# Optional model configuration for live Pi Agent conversations.
TRADING_AGENT_MODEL_PROVIDER=openai
TRADING_AGENT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Obsidian vault. Defaults to /Users/apple/Documents/HenryXu when unset.
OBSIDIAN_VAULT_PATH=/Users/apple/Documents/HenryXu
OBSIDIAN_KB_FOLDER=Serenity-A股产业投研

# A-share screener.
A_SHARE_MAX_ROWS=800
A_SHARE_TOP_N=15

# Feishu.
FEISHU_WEBHOOK_URL=
FEISHU_VERIFICATION_TOKEN=
FEISHU_PORT=8787

# Local licensed report/source inbox. Put PDF/MD/TXT files or manifest JSON here.
REPORT_INBOX=reports/inbox
